// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ======================================================
// ENUMS
// ======================================================

enum UserRole {
  ADMIN
  STAFF
  MEMBER
}

enum MotorType {
  AUTOMATIC
  MANUAL
}

enum CustomerType {
  MEMBER
  GUEST
}

enum OrderStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum OrderItemType {
  PRODUCT
  SERVICE
}

// USER

model User {
  id   Int      @id @default(autoincrement())
  role UserRole @default(MEMBER)

  phone String? @unique
  email String? @unique

  firstName String
  lastName  String
  password  String

  isActive        Boolean   @default(true)
  emailVerifiedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  userInfo   UserInfo?
  userMotors UserMotor[]

  memberOrders Order[] @relation("MemberOrder")
  saleOrders   Order[] @relation("Sale")

  authSessions AuthSession[]
}

// USER INFO

model UserInfo {
  id Int @id @default(autoincrement())

  userId   Int     @unique
  photoUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// AUTH SESSION
// Refresh token / logout / session management

model AuthSession {
  id Int @id @default(autoincrement())

  userId Int

  refreshToken String @unique

  expiresAt DateTime
  revokedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// PENDING REGISTRATION
// Email OTP verification before User creation

model PendingRegistration {
  id Int @id @default(autoincrement())

  email String @unique

  firstName String
  lastName  String

  passwordHash String
  otpHash      String

  expiresAt DateTime

  attempts   Int      @default(0)
  lastSentAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// MOTOR BRAND
// Admin controlled motorcycle brands

model MotorBrand {
  id Int @id @default(autoincrement())

  name String @unique

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  motors Motor[]
}

// MOTOR
// Admin controlled motorcycle model catalog

model Motor {
  id Int @id @default(autoincrement())

  motorBrandId Int

  model String
  type  MotorType

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  motorBrand MotorBrand @relation(fields: [motorBrandId], references: [id], onDelete: Restrict)

  userMotors UserMotor[]
  orders     Order[]

  // Prevent duplicate model under same brand
  @@unique([motorBrandId, model])
  @@index([motorBrandId])
}

// USER MOTOR
// Member <-> Motorcycle model relationship

model UserMotor {
  id Int @id @default(autoincrement())

  userId  Int
  motorId Int

  createdAt DateTime @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  motor Motor @relation(fields: [motorId], references: [id], onDelete: Restrict)

  // User cannot add same model twice
  @@unique([userId, motorId])
  @@index([userId])
  @@index([motorId])
}

// PRODUCT CATEGORY

model ProductCategory {
  id Int @id @default(autoincrement())

  name String @unique

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  products Product[]
}

// PRODUCT

model Product {
  id Int @id @default(autoincrement())

  productCategoryId Int

  sku         String  @unique
  name        String
  description String?

  costPrice    Decimal @db.Decimal(10, 2)
  sellingPrice Decimal @db.Decimal(10, 2)

  stockQuantity Int @default(0)

  unit String

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  productCategory ProductCategory @relation(fields: [productCategoryId], references: [id], onDelete: Restrict)

  orderItems OrderItem[]

  @@index([productCategoryId])
}

// SERVICE

model Service {
  id Int @id @default(autoincrement())

  name        String  @unique
  description String?

  price Decimal @db.Decimal(10, 2)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  orderItems OrderItem[]
}

// ORDER
// POS transaction

model Order {
  id Int @id @default(autoincrement())

  orderNumber String @unique

  // Customer/member
  memberId Int?

  // Staff/Admin who created the sale
  handledById Int

  // Motorcycle related to this sale
  motorId Int?

  customerType CustomerType

  subtotal Decimal @db.Decimal(10, 2)

  discountRate Decimal @default(0) @db.Decimal(5, 2)

  discountAmount Decimal @default(0) @db.Decimal(10, 2)

  finalTotal Decimal @db.Decimal(10, 2)

  status OrderStatus @default(PENDING)

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  // Relations

  member User? @relation("MemberOrder", fields: [memberId], references: [id], onDelete: SetNull)

  handledBy User @relation("Sale", fields: [handledById], references: [id], onDelete: Restrict)

  motor Motor? @relation(fields: [motorId], references: [id], onDelete: SetNull)

  orderItems OrderItem[]

  @@index([memberId])
  @@index([handledById])
  @@index([motorId])
  @@index([createdAt])
  @@index([status])
}

// ORDER ITEM
// Product or Service inside cart/order

model OrderItem {
  id Int @id @default(autoincrement())

  orderId Int

  productId Int?
  serviceId Int?

  itemType OrderItemType

  itemNameSnapshot String

  quantity Int @default(1)

  unitPrice Decimal @db.Decimal(10, 2)
  lineTotal Decimal @db.Decimal(10, 2)

  createdAt DateTime @default(now())

  // Relations

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  service Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
  @@index([serviceId])
}
